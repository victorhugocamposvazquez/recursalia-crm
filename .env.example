# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Sitio público (URLs en artículos SEO, redes y metadatos)
NEXT_PUBLIC_SITE_URL=https://tu-dominio.com

# OpenAI
OPENAI_API_KEY=sk-...

# Google Gemini (imagen destacada por curso)
GOOGLE_GEMINI_API_KEY=
# Opcional: por defecto gemini-2.5-flash-image (Nano Banana). Otros: gemini-3.1-flash-image-preview
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Reseñas por curso (default 50)
# COURSE_REVIEWS_COUNT=50

# Meta / Facebook & Instagram (publicación directa en redes sociales)
# Ver docs/META-SETUP.md para guía detallada y solución de errores 403/#10
# 1. Crear App en https://developers.facebook.com
# 2. Añadir permisos en App Review: pages_manage_posts, pages_read_engagement, instagram_basic, instagram_content_publish
# 3. Generar Page Access Token en Graph API Explorer (seleccionando la Página)
# META_PAGE_ACCESS_TOKEN=
# META_USER_ACCESS_TOKEN=
# META_PAGE_ID=
# META_INSTAGRAM_ID=

# Cron (Vercel Cron Job — publica borradores de blog desde Supabase)
# Generar un secreto aleatorio y configurarlo en Vercel Environment Variables
CRON_SECRET=
